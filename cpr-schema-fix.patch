From 0157444304b9bb24fa7b673c945a6e6217246d91 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 5 Sep 2026 17:36:09 +0000
Subject: [PATCH 2/2] ci: don't redeploy the React site for Sanity Studio-only
 changes

The cPanel deploy workflow triggered on every push to Dev regardless of
what changed, so a studio/ schema fix would still re-run the full FTP
deploy (dangerous-clean-slate: true) that hit a disk-full failure earlier.
Studio schema changes don't affect the React build output at all, and the
Studio itself deploys separately via `sanity deploy`.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012xNEugH42JGJDBqiHFtfyU
---
 .github/workflows/deploy.yml | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
index c205ff3..f73a3b7 100644
--- a/.github/workflows/deploy.yml
+++ b/.github/workflows/deploy.yml
@@ -3,6 +3,13 @@ name: Deploy to cPanel
 on:
   push:
     branches: [Dev]
+    # Only rebuild/redeploy the React site when something that actually
+    # affects its build output changes. The Sanity Studio (studio/) is a
+    # separate app deployed on its own (`sanity deploy`), so schema-only
+    # commits no longer trigger a cPanel FTP deploy.
+    paths-ignore:
+      - 'studio/**'
+      - '**.md'
 
 # Cancel in-progress runs for the same branch
 concurrency:
-- 
